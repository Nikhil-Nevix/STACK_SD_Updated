# STACK AI Service Desk — Environment Configuration Template
# Duplicate this file to '.env' in the same folder and configure values.

# ==========================================
# 1. Core Services & Database
# ==========================================
# Primary database URL (SQLAlchemy compatible PostgreSQL URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stack_db

# Secret key for encrypting sessions/tokens
SESSION_SECRET=super_secure_session_secret_key_change_me_in_prod

# Redis Cache & Message Broker (Celery)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 2. Azure OpenAI & Cognitive Services
# ==========================================
# Azure OpenAI API key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Endpoint base URL for Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# API Version to target
AZURE_OPENAI_API_VERSION=2023-05-15

# Deployment name for the main completion model (e.g. gpt-4o, gpt-35-turbo)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Deployment name for the embedding model (e.g. text-embedding-3-small)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ==========================================
# 3. Freshservice ITSM Integration
# ==========================================
# Domain URL of your Freshservice tenant (e.g. company.freshservice.com)
FRESHSERVICE_DOMAIN=company.freshservice.com

# API Key/Token with admin read/write permissions
FRESHSERVICE_API_KEY=your_freshservice_api_key_here

# ==========================================
# 4. Microsoft 365 & Graph API
# ==========================================
# Azure AD / Entra ID Directory (Tenant) ID
MS_TENANT_ID=your_microsoft_tenant_id_here

# Registered Entra ID Application (Client) ID
MS_CLIENT_ID=your_microsoft_client_id_here

# Secret generated for the application registration
MS_CLIENT_SECRET=your_microsoft_client_secret_here

# ==========================================
# 5. Software Licenses Provisioning
# ==========================================
# Adobe UMAPI & User Management credentials
ADOBE_CLIENT_ID=your_adobe_developer_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_developer_client_secret_here

# Bluebeam cloud API integration
BLUEBEAM_API_KEY=your_bluebeam_api_key_here

# ==========================================
# 6. Windows Remote Management (WinRM)
# ==========================================
# Username for WinRM connection on domain endpoints
WINRM_USERNAME=DomainAdminUser

# Password for domain admin account used by WinRM
WINRM_PASSWORD=your_secure_winrm_domain_password_here

# ==========================================
# 7. Google Chat Bot Platform
# ==========================================
# Multi-line string or path containing Service Account JSON credentials
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
